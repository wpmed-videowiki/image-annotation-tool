# Video worker image: the only container that needs ffmpeg/ffprobe.
# Runs src/workers/videoWorker.mjs directly with Node - no Next build.
FROM node:22.21.1-slim
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

# .npmrc skips the ~230 MB CUDA/TensorRT download that onnxruntime-node's
# postinstall would otherwise pull in; the CPU runtime is bundled
COPY package*.json .npmrc ./
ENV ONNXRUNTIME_NODE_INSTALL=skip
RUN npm install --omit=dev

COPY . .

CMD ["npm", "run", "start:worker:video"]
